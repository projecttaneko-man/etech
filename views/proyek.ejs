<%- include('partials/breadcrumb', {
  items: [
    { label: 'Etech', url: '/' },
    { label: 'Proyek' }
  ]
}) %>

<style>
  .pg-section { padding: 64px 0 80px; background: #fafafa; }
  .pg-head { text-align: center; max-width: 960px; margin: 0 auto 48px; }
  .pg-head h1 { font-size: clamp(2rem, 4vw, 2.75rem); color: #27408b; margin: 0 0 12px; }
  .pg-head h2 { font-size: clamp(1.1rem, 2vw, 1.5rem); color: #18243a; margin: 0 0 20px; }
  .pg-head p { color: #333; line-height: 1.7; margin: 0; }

  .pg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .pg-card {
    background: #fff;
    border-radius: 20px;
    padding: 16px 24px 32px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, .08);
  }
  .pg-media { aspect-ratio: 4 / 3; overflow: hidden; margin: 8px -8px 24px; background: #eee; }
  .pg-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pg-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .pg-tag { font-size: .78rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: #f4ede6; color: #6f4a2e; }
  .pg-tag-main { background: #b4561a; color: #fff; }
  .pg-title { font-size: 1.15rem; line-height: 1.4; color: #2a1f1a; margin: 0 0 4px; }
  .pg-via { margin: 0 0 14px; font-size: .9rem; color: #6f625a; }
  .pg-spec { display: grid; gap: 8px; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid #eee5dc; }
  .pg-spec > div { display: grid; grid-template-columns: 112px 1fr; gap: 10px; font-size: .92rem; }
  .pg-spec dt { color: #8a7a6e; }
  .pg-spec dd { margin: 0; color: #2a1f1a; font-weight: 500; overflow-wrap: anywhere; }

  .pg-info { text-align: center; color: #6f625a; font-size: .95rem; margin: 0 0 28px; }

  .pg-pagination { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 48px; }
  .pg-page {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 42px; height: 42px; padding: 0 14px;
    border: 1px solid #e3d9d0; border-radius: 10px; background: #fff;
    color: #2a1f1a; font-weight: 600; text-decoration: none;
    transition: background .2s, color .2s, border-color .2s;
  }
  .pg-page:hover { border-color: #b4561a; color: #b4561a; }
  .pg-page.is-active { background: #b4561a; border-color: #b4561a; color: #fff; }

  @media (max-width: 900px) { .pg-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .pg-grid { grid-template-columns: 1fr; }
    .pg-section { padding: 40px 0 56px; }
  }
</style>

<section class="pg-section" id="daftar-proyek">
  <div class="wrap">
    <div class="pg-head">
      <h1>Proyek Kami</h1>
      <h2>Solusi Daya Terintegrasi dengan Pilihan Engine Global Terkemuka</h2>
      <p>Etech telah mendukung berbagai kebutuhan daya untuk industri, komersial, dan proyek skala besar. Setiap instalasi dilakukan dengan perencanaan teknis yang matang dan standar kerja profesional untuk memastikan sistem berjalan optimal.</p>
    </div>

    <p class="pg-info">Menampilkan <%= from %>–<%= to %> dari <%= total %> proyek</p>

    <div class="pg-grid">
      <% projects.forEach(function (p) { %>
        <article class="pg-card">
          <div class="pg-media">
            <img src="<%= p.image %>" alt="<%= p.name %>" width="400" height="300" loading="lazy">
          </div>
          <div class="pg-tags">
            <% if (p.units) { %><span class="pg-tag pg-tag-main"><%= p.units %> × <%= p.kva %> kVA</span><% } %>
            <span class="pg-tag"><%= p.type %></span>
            <% p.extras.forEach(function (x) { %><span class="pg-tag"><%= x %></span><% }); %>
          </div>
          <h3 class="pg-title"><%= p.name %></h3>
          <% if (p.via) { %><p class="pg-via">Melalui <%= p.via %></p><% } %>
          <dl class="pg-spec">
            <div><dt>Model</dt><dd><%= p.model %></dd></div>
            <div><dt>Mesin</dt><dd><%= p.engine %></dd></div>
            <div><dt>Alternator</dt><dd><%= p.alternator %></dd></div>
            <div><dt>Panel kontrol</dt><dd><%= p.controller %></dd></div>
          </dl>
        </article>
      <% }); %>
    </div>

    <% if (totalPages > 1) { %>
      <nav class="pg-pagination" aria-label="Halaman proyek">
        <% if (page > 1) { %>
          <a class="pg-page pg-page-nav" href="/proyek?page=<%= page - 1 %>#daftar-proyek" rel="prev">← Sebelumnya</a>
        <% } %>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a class="pg-page<%= i === page ? ' is-active' : '' %>" href="/proyek?page=<%= i %>#daftar-proyek"<%- i === page ? ' aria-current="page"' : '' %>><%= i %></a>
        <% } %>
        <% if (page < totalPages) { %>
          <a class="pg-page pg-page-nav" href="/proyek?page=<%= page + 1 %>#daftar-proyek" rel="next">Selanjutnya →</a>
        <% } %>
      </nav>
    <% } %>
  </div>
</section>

<%- include('partials/cta-band', {
  sectionId: 'rfq',
  heading: 'Punya proyek serupa?',
  text: 'Kirim kebutuhan daya Anda, tim kami akan menghubungi dalam 1x24 jam kerja.',
  ctaLabel: 'Hubungi Kami →',
  ctaUrl: 'https://wa.me/6285196095854'
}) %>
