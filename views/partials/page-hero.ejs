<%# Cara pakai: include partials/page-hero dengan data { heading, text, image } %>
<div class="page-hero">
  <div class="page-hero-media">
    <img src="<%= image %>" alt="<%= heading %>">
    <div class="page-hero-overlay"></div>
  </div>
  <div class="wrap page-hero-inner">
    <h1><%= heading %></h1>
    <p><%= text %></p>
  </div>
</div>