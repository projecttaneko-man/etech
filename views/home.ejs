<%# ===== Data hero ===== %>
<% const heroSlides = [
  { image: '/images/brands/hero-home.png', alt: 'Genset industrial Etech di area bandara dan gedung komersial' }
  // Tambah slide lain dengan format yang sama, mis:
  // { image: '/images/hero/hero-2.jpg', alt: '...' }
  // Jika slide > 1, indikator "01 / 0N" dan pergantian otomatis aktif sendiri (lihat main.js).
]; %>

<% const sektorList = [
  { icon: 'industrial',  title: 'Industrial Generator',  desc: 'Untuk kebutuhan daya besar & operasional berat dalam jangka panjang.',          url: '/produk' },
  { icon: 'commercial',  title: 'Commercial Generator',  desc: 'Untuk mendukung aktivitas bisnis dengan sistem daya yang stabil dan efisien.', url: '/produk' },
  { icon: 'standby',     title: 'Standby Generator',     desc: 'Sebagai sumber daya cadangan otomatis saat terjadi pemadaman listrik.',        url: '/produk' },
  { icon: 'residential', title: 'Residential Generator', desc: 'Solusi praktis dan ringkas untuk kebutuhan rumah tangga dan usaha kecil.',     url: '/produk' }
]; %>

<%# Path SVG (stroke) untuk ikon tiap tipe generator %>
<% const sektorIcons = {
  industrial:  '<path d="M3 21h18"/><path d="M5 21V11l6 4v-4l6 4V5h3v16"/><path d="M9 18h1M14 18h1"/>',
  commercial:  '<rect x="4" y="9" width="8" height="12" rx="1"/><rect x="12" y="3" width="8" height="18" rx="1"/><path d="M7 13h2M7 17h2M15 7h2M15 11h2M15 15h2M2 21h20"/>',
  standby:     '<path d="M12 2.5v5M9.5 5h5"/><rect x="4" y="10" width="16" height="11" rx="1.5"/><path d="M9.5 21v-5h5v5M8 13.5h1M11.5 13.5h1M15 13.5h1"/>',
  residential: '<path d="M3 11 12 3l9 8"/><path d="M5 10v11h14V10"/><path d="M10 21v-6h4v6"/>'
}; %>

<section class="hh" data-hero-slider data-hero-glow aria-label="Beranda">
  <div class="hh-slides">
    <% heroSlides.forEach(function(slide, i) { %>
      <div class="hh-slide<%= i === 0 ? ' is-active' : '' %>">
        <img src="<%= slide.image %>" alt="<%= slide.alt %>" width="1920" height="1080"<%- i === 0 ? ' fetchpriority="high"' : ' loading="lazy"' %>>
      </div>
    <% }); %>
  </div>
  <div class="hh-overlay"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="wrap hh-content">
    <h1>Genset Berkualitas untuk Operasional
      <span class="accent rotate-text" data-rotate-text
            data-rotate-words="Tanpa Henti,Siap Kapan Saja,Andal Sepanjang Waktu">Tanpa Henti</span>
    </h1>
    <p class="hh-sub">Kami menyediakan genset dengan kualitas terbaik, teknologi modern, dan layanan profesional untuk mendukung kelancaran bisnis dan operasional Anda.</p>
    <div class="hh-ctas">
      <a href="/produk" class="hh-btn" data-magnetic>Lihat Produk Kami <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="hh-bottom">
    <% if (heroSlides.length > 1) { %>
      <div class="hh-slider-ui">
        <div class="hh-dashes">
          <% heroSlides.forEach(function(slide, i) { %>
            <button type="button" class="hh-dash<%= i === 0 ? ' is-active' : '' %>" aria-label="Tampilkan slide <%= i + 1 %>"></button>
          <% }); %>
        </div>
        <div class="hh-counter"><span data-hh-current>01</span> / <%= String(heroSlides.length).padStart(2, '0') %></div>
      </div>
    <% } %>

    <a class="hh-banner" href="/solusi-bisnis">
      <span class="hh-banner-photo"><img src="/images/brands/subhero.webp" alt="" width="320" height="200" loading="lazy"></span>
      <span class="hh-banner-text">
        <span class="hh-banner-kicker">KAMI HADIR UNTUK</span>
        <strong>Dukung Setiap Langkah Operasional Anda</strong>
      </span>
      <span class="hh-banner-arrow" aria-hidden="true">→</span>
    </a>

    <ul class="hh-sektor">
      <% sektorList.forEach(function(sektor) { %>
        <li>
          <a href="<%= sektor.url %>">
            <span class="hh-sektor-icon">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- sektorIcons[sektor.icon] %></svg>
            </span>
            <span class="hh-sektor-text">
              <strong><%= sektor.title %></strong>
              <small><%= sektor.desc %></small>
            </span>
          </a>
        </li>
      <% }); %>
    </ul>
  </div>
</section>

<section id="kenapa">
  <div class="wrap">
    <%- include('partials/section-heading', {
      heading: 'Alasan klien mempercayakan kebutuhan daya mereka ke Etech',
      text: 'Empat prinsip kerja yang kami pegang di setiap proyek, besar maupun kecil.'
    }) %>
    <div class="why-grid">
      <div class="reason-item">
        <h3>Perencanaan Matang</h3>
        <p>Setiap kebutuhan direncanakan secara detail dan profesional agar solusi yang diberikan tepat sasaran dan efisien.</p>
      </div>
      <div class="reason-item">
        <h3>Produk Andal</h3>
        <p>Hanya menawarkan unit berkualitas tinggi yang tangguh dan siap bekerja optimal di berbagai kondisi lapangan.</p>
      </div>
      <div class="reason-item">
        <h3>Eksekusi Presisi</h3>
        <p>Bekerja cepat, tepat, dan penuh ketelitian di setiap tahap — dari survei kebutuhan hingga serah terima unit.</p>
      </div>
      <div class="reason-item">
        <h3>Purna Jual Responsif</h3>
        <p>Layanan servis dan dukungan teknis yang cepat tanggap agar operasional Anda tetap berjalan tanpa hambatan.</p>
      </div>
    </div>
  </div>
</section>

<section id="tipe" style="background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
  <div class="wrap">
    <div class="tipe-layout">
      <div class="tipe-collage">
        <div class="tipe-collage-dots"></div>
        <div class="tipe-img-main"><img src="/images/brands/tipe1.jpg" alt="Genset industrial Etech"></div>
        <div class="tipe-img-sub"><img src="/images/brands/tipe2.jpg" alt="Detail unit genset"></div>
      </div>
      <div>
        <%- include('partials/section-heading', {
          heading: 'Sesuaikan genset dengan kebutuhan lapangan Anda',
          text: 'Empat kategori utama — silakan sesuaikan dengan kondisi lokasi dan kebutuhan daya Anda.',
          center: true
        }) %>
        <div class="tipe-points">
          <% const tipeList = [
            { title: 'Open Type', desc: 'Tanpa rumah pelindung, cocok untuk ruang genset tersendiri atau fasilitas indoor.' },
            { title: 'Silent Type', desc: 'Dilengkapi kanopi peredam suara untuk lingkungan yang membutuhkan tingkat kebisingan rendah.' },
            { title: 'Genset Portable', desc: 'Dirancang untuk mobilitas tinggi dengan roda, mudah dipindahkan untuk kebutuhan lapangan atau outdoor.' },
            { title: 'Genset Bensin', desc: 'Menggunakan bahan bakar bensin, cocok untuk kebutuhan daya sementara atau situasi darurat.' }
          ]; %>
          <% tipeList.forEach(function(item, i) { %>
            <div class="tipe-point">
              <div class="tipe-num"><%= i + 1 %></div>
              <div>
                <h4><%= item.title %></h4>
                <p><%= item.desc %></p>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="customer" class="customer-section">
  <div class="wrap">
    <%- include('partials/section-heading', {
      heading: 'Dipercaya oleh berbagai instansi dan perusahaan',
      text: 'Kami melayani kebutuhan kelistrikan untuk sektor industri, komersial, hingga pemerintahan.',
      center: true
    }) %>
    <div class="customer-grid">
      <% if (typeof clients !== 'undefined' && clients && clients.length) { %>
        <% clients.forEach(function(client) { %>
          <div class="customer-tile"><img src="<%= client.logo %>" alt="<%= client.name %>"></div>
        <% }); %>
      <% } else { %>
        <% for (let i = 0; i < 8; i++) { %>
          <div class="customer-tile" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="11" rx="1"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</section>

<section id="produk" class="produk-notice">
  <div class="wrap">
    <%- include('partials/section-heading', {
      heading: 'Beberapa produk unggulan kami',
      center: true
    }) %>
    <div class="products-simple">
      <% products.forEach(function(product) { %>
        <%- include('partials/product-simple-card', { product: product }) %>
      <% }); %>
    </div>
  </div>
</section>

<section class="brand-section">
  <div class="wrap">
    <div class="mitra-head">
      <div class="mitra-head-title">
        <p class="mitra-sub">Distributor Resmi Genset Merk Terbaik</p>
        <h2>Generator Set dari Berbagai Merk</h2>
      </div>
      <p class="mitra-desc">Kami menawarkan berbagai jenis generator set dari berbagai merk terkenal dan terpercaya, yang dapat memenuhi kebutuhan listrik Anda. Dengan pilihan kapasitas mulai dari kecil hingga besar, kami menyediakan generator set yang dapat diandalkan untuk digunakan di berbagai jenis lingkungan dan lokasi. Kami juga menjamin kualitas produk yang kami jual dan memberikan garansi yang memadai untuk setiap pembelian generator set.</p>
    </div>
    <div class="partner-marquee" data-marquee>
      <% const brandList = [
        { name: 'MTU', logo: '/images/brands/mtu.png' },
        { name: 'Perkins', logo: '/images/brands/perkins.webp' },
        { name: 'Mitsubishi', logo: '/images/brands/mitsubishi.png' },
        { name: 'Yuchai', logo: '/images/brands/Yuchai-resized-logo.jpeg' },
        { name: 'Cummins', logo: '/images/brands/cummins.webp' },
        { name: 'Yanmar', logo: '/images/brands/yanmar.png' },
        { name: 'Deutz', logo: '/images/brands/deutz.webp' },
        { name: 'Isuzu', logo: '/images/brands/isuzu.webp' },
        { name: 'Kubota', logo: '/images/brands/kubota.png' },
        { name: 'Doosan', logo: '/images/brands/doosan.png' },
        { name: 'Volvo Penta', logo: '/images/brands/volvo.png' }
      ]; %>
      <% const brandsToShow = (typeof brands !== 'undefined' && brands && brands.length) ? brands : brandList; %>
      <div data-marquee-track>
        <% brandsToShow.forEach(function(brand) { %>
          <div class="partner-tile">
            <img src="<%= brand.logo %>" alt="<%= brand.name %>">
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<section class="cta-final">
  <div class="cta-dome">
    <div class="cta-blob cta-blob-a"></div>
    <div class="cta-blob cta-blob-b"></div>
    <div class="cta-dots"></div>
    <div class="wrap">
      <div class="cta-copy">
        <h2>Mari bangun sistem daya Anda bersama kami</h2>
        <p>Konsultasikan kebutuhan Anda sekarang dan temukan solusi kelistrikan yang tepat.</p>
      </div>
      <a href="https://wa.me/6285196095854" target="_blank" rel="noopener" class="btn btn-cta" data-magnetic>Hubungi Kami →</a>
    </div>
  </div>
  <svg width="0" height="0" style="position:absolute;" aria-hidden="true">
    <defs>
      <clipPath id="ctaWaveClip" clipPathUnits="objectBoundingBox">
        <path d="M0,1 L0,0.22 C 0.25,0.05 0.75,0 1,0.16 L1,1 Z"></path>
      </clipPath>
    </defs>
  </svg>
</section>
